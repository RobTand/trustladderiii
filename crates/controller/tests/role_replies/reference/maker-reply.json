{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/maker-reply.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "budget_exhaustion": {"$ref": "#/$defs/budget_exhaustion", "description": "Added by worker code. The model must omit this field."},
        "kind": {"const": "done"},
        "head": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "description": "Added by worker code. The model must omit this field."},
        "reproductions": {"type": "array", "items": {"$ref": "#/$defs/reproduction"}},
        "test_evidence": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/test_run"}, "description": "Added by worker code. The model must omit this field."},
        "checking_handoff": {"$ref": "#/$defs/checking_handoff", "description": "Added by worker code. Ordinary demonstrating proof remains pending for independent Checking. The model must omit this field."},
        "generation_evidence": {"$ref": "#/$defs/generation_receipt", "description": "Added by worker code after verified import. The model must omit this field."},
        "self_check": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "goal_id": {
                    "$ref": "#/$defs/text"
                  },
                  "status": {
                    "const": "met"
                  },
                  "evidence": {
                    "$ref": "#/$defs/text"
                  }
                },
                "required": [
                  "goal_id",
                  "status",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "goal_id": {
                    "$ref": "#/$defs/text"
                  },
                  "status": {
                    "const": "not_met"
                  },
                  "why": {
                    "$ref": "#/$defs/text"
                  }
                },
                "required": [
                  "goal_id",
                  "status",
                  "why"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "goal_id": {
                    "$ref": "#/$defs/text"
                  },
                  "status": {
                    "const": "pending"
                  },
                  "why": {
                    "$ref": "#/$defs/text"
                  }
                },
                "required": [
                  "goal_id",
                  "status",
                  "why"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "kind",
        "self_check",
        "head"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "budget_exhaustion": {"$ref": "#/$defs/budget_exhaustion", "description": "Added by worker code. The model must omit this field."},
        "kind": {
          "const": "needs_files"
        },
        "fits": {
          "type": "boolean",
          "description": "Added by worker code. The model must omit this field."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "#/$defs/text"
              },
              "why": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "path",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "files"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "description": "Only when a maker-owned goal cannot be met within the declared files and tools, the plan is defective, or evidence preflight names a truly unsupported requirement. Ordinary controller-owned checks and PR publication are pending downstream work. Not for unfinished steps your own tools can do.",
      "properties": {
        "budget_exhaustion": {"$ref": "#/$defs/budget_exhaustion", "description": "Added by worker code. The model must omit this field."},
        "unfinished_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "kind": {
          "const": "cant_meet"
        },
        "report": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "kind",
        "report"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "budget_exhaustion": {"$ref": "#/$defs/budget_exhaustion", "description": "Added by worker code. The model must omit this field."},
        "kind": {
          "const": "blocked"
        },
        "evidence": {
          "description": "An action_key whose run_tests summary had status infrastructure_error, or a tool_error id, recorded in this run.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "action_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "class": {
                  "const": "test_infrastructure",
                  "description": "Added by worker code. The model must omit this field."
                }
              },
              "required": [
                "action_key",
                "class"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "tool_error": {"type": "string", "pattern": "^tool-error-[1-9][0-9]*$"},
                "tool": {"enum": ["list", "read", "glob", "grep", "write", "edit", "run_tests", "run_generator", "recall"], "description": "Added by worker code. The model must omit this field."},
                "class": {"enum": ["test_submission", "EACCES", "EPERM", "EROFS", "ENOSPC", "EDQUOT", "EIO", "EMFILE", "ENFILE", "ENOMEM"], "description": "Added by worker code. The model must omit this field."}
              },
              "required": [
                "tool_error",
                "tool",
                "class"
              ],
              "additionalProperties": false
            }
          ]
        },
        "report": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "kind",
        "evidence",
        "report"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "budget_exhaustion": {"$ref": "#/$defs/budget_exhaustion", "description": "Added by worker code. The model must omit this field."},
        "kind": {
          "const": "out_of_room"
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "budget_exhaustion": {
      "type": "object",
      "description": "Code-owned execution-budget stop, never semantic impossibility or completed proof.",
      "properties": {
        "kind": {
          "const": "execution_budget_exhausted"
        },
        "dimension": {
          "enum": [
            "backstop",
            "no_progress",
            "context_tokens",
            "input_tokens"
          ]
        },
        "compaction_count": {"type": "integer", "minimum": 0},
        "context_fraction": {"type": "number", "minimum": 0},
        "no_progress_window": {"type": "integer", "minimum": 0},
        "no_progress_turns": {"type": "integer", "minimum": 0},
        "last_progress_kind": {"enum": [null, "read", "grep", "glob", "write", "edit", "run_tests"]},
        "tool_turns": {
          "type": "object",
          "properties": {
            "used": {
              "type": "integer",
              "minimum": 0
            },
            "allowed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "used",
            "allowed"
          ],
          "additionalProperties": false
        },
        "input_tokens": {
          "type": "object",
          "properties": {
            "used": {
              "type": "integer",
              "minimum": 0
            },
            "allowed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "used",
            "allowed"
          ],
          "additionalProperties": false
        },
        "operation": {
          "type": "object",
          "properties": {
            "node": {
              "type": "integer",
              "minimum": 0
            },
            "generation": {
              "type": "integer",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "node",
            "generation",
            "kind"
          ],
          "additionalProperties": false
        },
        "preserved_work": {
          "type": "object",
          "properties": {
            "head": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "tree": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            }
          },
          "required": [
            "head",
            "tree"
          ],
          "additionalProperties": false
        },
        "unfinished_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "dimension",
        "no_progress_window",
        "no_progress_turns",
        "last_progress_kind",
        "tool_turns",
        "input_tokens",
        "operation",
        "preserved_work",
        "unfinished_obligations"
      ],
      "additionalProperties": false
    },
    "checking_handoff": {"type": "object", "properties": {"base_sha": {"oneOf": [{"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, {"type": "null"}]}, "head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "head_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "status": {"const": "pending"}, "owner": {"const": "checking"}, "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1}, "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "mode": {"const": "base_subject_head_observer"}}, "required": ["name", "tests", "mode"], "additionalProperties": false}}}, "required": ["base_sha", "head_sha", "head_tree", "status", "owner", "checks"], "additionalProperties": false},
    "generation_receipt": {"type": "object", "properties": {"action_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "output_manifest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "input_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "output_tree": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}, "status": {"const": "completed"}, "exit_code": {"const": 0}, "command": {"type": "string", "minLength": 1}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "identity": {"type": "object", "properties": {"implementation": {"enum": ["tl3-generator-v3", "tl3-generator-v4"]}, "image": {"type": "string"}, "budget": {"type": "object", "properties": {"cpus": {"type": "integer", "minimum": 1, "maximum": 16}, "mem_gb": {"type": "integer", "minimum": 1, "maximum": 64}, "timeout_s": {"type": "integer", "minimum": 1, "maximum": 600}, "outer_timeout_s": {"type": "integer", "minimum": 61, "maximum": 660}}, "required": ["cpus", "mem_gb", "timeout_s", "outer_timeout_s"], "additionalProperties": false}}, "required": ["implementation", "image", "budget"], "additionalProperties": false}, "output_count": {"type": "integer", "minimum": 0, "maximum": 128}, "budget": {"type": "object", "properties": {"cpus": {"type": "integer", "minimum": 1, "maximum": 16}, "mem_gb": {"type": "integer", "minimum": 1, "maximum": 64}, "timeout_s": {"type": "integer", "minimum": 1, "maximum": 600}, "outer_timeout_s": {"type": "integer", "minimum": 61, "maximum": 660}}, "required": ["cpus", "mem_gb", "timeout_s", "outer_timeout_s"], "additionalProperties": false}, "timings": {"type": "object", "properties": {"preparation": {"type": "object", "properties": {"seconds": {"type": "number", "minimum": 0}, "outcome": {"enum": ["completed", "failed", "timeout", "skipped"]}, "scope": {"const": "startup_and_command"}}, "required": ["seconds", "outcome"], "additionalProperties": false}, "container": {"type": "object", "properties": {"seconds": {"type": "number", "minimum": 0}, "outcome": {"enum": ["completed", "failed", "timeout", "skipped"]}, "scope": {"const": "startup_and_command"}}, "required": ["seconds", "outcome"], "additionalProperties": false}, "validation": {"type": "object", "properties": {"seconds": {"type": "number", "minimum": 0}, "outcome": {"enum": ["completed", "failed", "timeout", "skipped"]}, "scope": {"const": "startup_and_command"}}, "required": ["seconds", "outcome"], "additionalProperties": false}, "cleanup": {"type": "object", "properties": {"seconds": {"type": "number", "minimum": 0}, "outcome": {"enum": ["completed", "failed", "timeout", "skipped"]}, "scope": {"const": "startup_and_command"}}, "required": ["seconds", "outcome"], "additionalProperties": false}, "total_seconds": {"type": "number", "minimum": 0}}, "required": ["preparation", "container", "validation", "cleanup", "total_seconds"], "additionalProperties": false}, "phase": {"const": "completed"}, "inner": {"type": "object", "properties": {"status": {"const": "completed"}, "exit_code": {"const": 0}}, "required": ["status", "exit_code"], "additionalProperties": false}, "outer": {"type": "object", "properties": {"status": {"enum": ["executed", "cache_hit"]}, "exit_code": {"const": 0}, "elapsed_s": {"type": ["number", "null"], "minimum": 0}}, "required": ["status", "exit_code", "elapsed_s"], "additionalProperties": false}}, "required": ["action_key", "artifact_sha256", "receipt_sha256", "output_manifest", "input_tree", "output_tree", "status", "exit_code", "command", "argv", "identity", "output_count", "budget", "timings", "phase", "inner", "outer"], "additionalProperties": false},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "selector_identity": {
      "type": "object",
      "description": "Exact ordered selector identity; prefix is display text only.",
      "properties": {
        "schema": {"const": "tl3.selectors.v1"},
        "count": {"type": "integer", "minimum": 0, "maximum": 256},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prefix": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 120}}
      },
      "required": ["schema", "count", "sha256", "prefix"],
      "additionalProperties": false
    },
    "test_run": {
      "type": "object",
      "description": "A completed run_tests call with its PrismaBuild receipts (#408).",
      "properties": {
        "tests": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "tests_identity": {"$ref": "#/$defs/selector_identity"},
        "tests_omitted": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "base": {
          "type": "boolean"
        },
        "base_semantics": {"enum": ["untouched_base", "base_subject_head_observer"]},
        "proof": {"$ref": "reviewer-input.json#/properties/checks/items/properties/proof"},
        "execution": {
          "type": "object",
          "properties": {
            "outcome": {"const": "test_timeout"},
            "phase": {"enum": ["test_run", "cleanup"]},
            "termination_reason": {"const": "no_progress"},
            "test_started": {"const": true},
            "test": {"type": "string", "maxLength": 2048}
          },
          "required": ["outcome", "phase", "termination_reason", "test_started"],
          "additionalProperties": false
        },
        "tree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "description": "The git tree of the checkout this run tested."
        },
        "fresh": {
          "type": "boolean",
          "description": "False when PrismaBuild replayed a stored result."
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "parallel": {
          "enum": [
            0,
            2,
            3,
            4
          ]
        },
        "status": {
          "const": "completed"
        },
        "totals": {
          "$ref": "#/$defs/totals"
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "action_key": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "executed",
                  "cache_hit"
                ]
              },
              "exit_code": {
                "type": "integer"
              },
              "attempt": {"type": "integer", "minimum": 1},
              "generation": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "log_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "action_key",
              "status",
              "exit_code",
              "receipt_sha256",
              "log_sha256"
            ],
            "additionalProperties": false
          }
        },
        "runs": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "properties": {
              "run": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "status": {
                "const": "completed"
              },
              "totals": {
                "$ref": "#/$defs/totals"
              }
            },
            "required": [
              "run",
              "status",
              "totals"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tests",
        "base",
        "repeat",
        "parallel",
        "status",
        "tree",
        "fresh",
        "totals",
        "receipts"
      ],
      "additionalProperties": false
    },
    "totals": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "passed",
        "failed",
        "error",
        "skipped"
      ],
      "additionalProperties": false
    },
    "reproduction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "finding_id": {
              "$ref": "#/$defs/text"
            },
            "tests": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "proof": {
              "$ref": "planner-reply.json#/$defs/proof"
            }
          },
          "required": [
            "finding_id",
            "tests",
            "proof"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "finding_id": {
              "$ref": "#/$defs/text"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "finding_id",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
