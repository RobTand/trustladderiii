# One Python edge run, in-process across fixtures, while the action copy remains.
py_test(
    name = "test_limits_boundary",
    srcs = ["//crates/harness-core:tests/fixtures/limits/test_boundary.py"],
    main = "//crates/harness-core:tests/fixtures/limits/test_boundary.py",
    data = ["//crates/harness-core:tests/fixtures/limits/delay.json"],
    deps = ["//harness/src/tl3_harness"],
    size = "small",
    timeout = "short",
)
