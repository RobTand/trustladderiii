# #835: independent groups over the real production source, with witnesses.
load("//tools/bazel:verus.bzl", "verus_test")
load("@rules_python//python:defs.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "red_match.rs",
    "red_match_spec.rs",
])

verus_test(
    name = "limits_arithmetic",
    src = "limits_arithmetic.rs",
    srcs = ["//crates/harness-core:src/limits.rs"],
    module = "limits::arithmetic",
    expected_obligations = 5,
    tags = ["rust", "verus"],
    size = "small",
    timeout = "short",
    target_compatible_with = ["@platforms//cpu:x86_64"],
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    exec_properties = {"EstimatedCPU": "1", "EstimatedComputeUnits": "1", "EstimatedMemory": "1GB"},
)

