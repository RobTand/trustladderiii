  "$defs": {
    "ExpectedRun": {
      "type": "object",
      "properties": {
        "base": {
          "type": "boolean"
        },
        "base_sha": true,
        "declared_symptom": true,
        "forcing": true,
        "proof": true,
        "selected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tree": true
      },
      "required": [
        "base",
        "base_sha",
        "tree",
        "selected",
        "proof",
        "forcing",
        "declared_symptom"
      ]
    },
    "FailedRecord": {
      "type": "object",
      "properties": {
        "action_key": true,
        "detail": true,
        "published_unix": true
      },
      "additionalProperties": false,
      "required": [
        "action_key",
        "published_unix",
        "detail"
      ]
    },
    "Forcing": {
      "description": "A forced reproduction (#393): the declarative condition the harness applies, outside the test, to recreate a flake. Only on demonstrating checks.",
      "type": "object",
      "properties": {
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000
          },
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          }
        },
        "patches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "delay_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 5
              },
              "raises": {
                "type": "string",
                "minLength": 1
              },
              "returns": {},
              "target": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
              },
              "value": {}
            },
            "additionalProperties": false,
            "maxProperties": 2,
            "minProperties": 2,
            "required": [
              "target"
            ]
          },
          "maxItems": 8
        },
        "symptom": {
          "type": "string",
          "maxLength": 1000,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "symptom",
        "environment",
        "patches"
      ]
    },
    "GeneratorContract": {
      "type": "object",
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget": true,
        "command": {
          "type": "string"
        },
        "generated_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "string"
        },
        "implementation": {
          "type": "string"
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "command",
        "argv",
        "generated_files",
        "protected_paths",
        "image",
        "implementation",
        "budget"
      ]
    },
    "PbEnding": {
      "description": "External PB fields preserve Python scalar distinctions until boundary decoding.",
      "type": "object",
      "properties": {
        "action_key": {
          "default": null
        },
        "attempt": {
          "default": null
        },
        "diagnostics": {
          "default": null
        },
        "exit_code": {
          "default": null
        },
        "publication": {
          "default": null
        },
        "reason": {
          "default": null
        },
        "result": {
          "default": null
        },
        "status": {
          "default": null
        },
        "succeeded": {
          "default": null
        }
      }
    }
