ARG TARGETARCH=amd64
FROM ghcr.io/actions/actions-runner@sha256:0ce3288e48b012a83685998f683a2ae0cbd284fa722c090dda0af5443215cf30 AS runner-amd64
FROM ghcr.io/actions/actions-runner@sha256:2089924d7fb6a96f1d1d2aca242ad6a07315b4ec2d7d275391ee265de70e941b AS runner-arm64
FROM runner-${TARGETARCH}

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential ca-certificates curl git jq pkg-config shellcheck unzip xz-utils \
       systemd libssl-dev libssl3t64 libicu74 libldap2 libxml2 libxslt1.1 \
       libreadline8t64 liblz4-1 libzstd1 libpam0g libkrb5-3 libcurl4t64 libedit2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/hostedtoolcache \
    && chown runner:runner /opt/hostedtoolcache

USER runner
ENV PATH=/home/runner/.cargo/bin:${PATH} \
    AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache \
    ACTIONS_RUNNER_PRINT_LOG_TO_STDOUT=0 \
    CARGO_BUILD_JOBS=4 \
    RUST_TEST_THREADS=4 \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1
RUN download_dir=$(mktemp -d) \
    && cd "$download_dir" \
    && case "$(uname -m)" in \
        x86_64) rust_arch=x86_64; rustup_sha=5be191e8c70a5007074254cb74d78dbfdd25cd5a61c27de7b8e5410122ec24f4 ;; \
        aarch64) rust_arch=aarch64; rustup_sha=a9c168dbea81a84671c6b7a5c1795cb0eb699020110d107ddfca427bd797e697 ;; \
        *) exit 1 ;; \
       esac \
    && curl -fsSLo rustup-init "https://static.rust-lang.org/rustup/dist/$rust_arch-unknown-linux-gnu/rustup-init" \
    && printf '%s  rustup-init\n' "$rustup_sha" | sha256sum -c - \
    && chmod 700 rustup-init \
    && ./rustup-init -y --no-modify-path --default-toolchain none \
    && rustup toolchain install 1.99.1 --profile minimal --component rustfmt --component clippy \
    && rustup default 1.99.1 \
    && rm -rf "$download_dir"

COPY --chown=runner:runner runner-entrypoint.sh /home/runner/runner-entrypoint.sh
WORKDIR /home/runner
ENTRYPOINT ["/bin/bash", "/home/runner/runner-entrypoint.sh"]
