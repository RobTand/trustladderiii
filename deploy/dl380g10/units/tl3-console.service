[Unit]
Description=TL3 operator console
Requires=tl3-postgres.service
PartOf=tl3-postgres.service
After=tl3-postgres.service

[Service]
Type=exec
UMask=0077
LoadCredential=console-postgres-password:%h/.config/tl3/secrets/console-postgres-password
RuntimeDirectory=tl3-console
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 %h/.local/share/tl3/deploy/deploy.py service --service console
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
