[Unit]
Description=CircleCI isolated machine runner slot %i
StartLimitIntervalSec=0

[Service]
EnvironmentFile=%h/.config/circleci-fleet/runner.env
ExecStart=%h/.local/libexec/circleci-fleet/slot.sh %i
ExecStop=/usr/bin/podman stop --time 300 circleci-fleet-%i
Restart=always
RestartSec=30
TimeoutStopSec=330
CPUWeight=20
Nice=10

[Install]
WantedBy=default.target
