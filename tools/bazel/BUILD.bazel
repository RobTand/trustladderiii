load("@rules_python//python:defs.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load("@tl3_pip//:requirements.bzl", "all_requirements")
load("//tools/bazel:python.bzl", "py_library", "tl3_py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "python_runner.py",
    "requirements.txt",
    "runtime.py",
    "rust_runner.py",
])

# One pinned rbe-ubuntu24-04 index: these are its amd64 and arm64 manifests.
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:5f0c01e5f6d79e58d7a996330de33aa38ce599bf8431eaf27521e7602daadf50",
        # Hermetic by default; tests in nonhermetic.bzl opt back in.
        "dockerNetwork": "off",
        "dockerUser": "1000:1000",
    },
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    exec_properties = {
        "Arch": "arm64",
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:2f48fc6c0c7f0794a76c74d77ff23b1a80944e05acacff22c63da2ef002ebf9b",
        "dockerNetwork": "off",
        "dockerUser": "1000:1000",
    },
)

# Read by the workspace contract tests in tools/ci.
filegroup(
    name = "sources",
    srcs = glob([
        "*.bzl",
        "*.py",
        "*.sh",
        "*.txt",
    ]) + ["BUILD.bazel"],
)

py_binary(
    name = "python_runner",
    srcs = ["python_runner.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":runtime",
        "@tl3_pip//pytest",
    ],
)

py_binary(
    name = "rust_builds",
    srcs = ["rust_builds.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "rust_runner",
    srcs = ["rust_runner.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":runtime",
        "//tools/ci:rust_gate",
    ],
)

py_binary(
    name = "worker_python",
    srcs = ["worker_python.py"],  # keep
    data = ["//workers:runtime_files"],
    visibility = ["//visibility:public"],
    deps = all_requirements + [
        ":runtime",
        "//harness/src/tl3_harness",
        "//workers/src",
    ],  # keep
)

# gazelle:python_ignore_files worker_python.py

py_binary(
    name = "requirements",
    srcs = ["requirements.py"],
    visibility = ["//visibility:public"],
)

py_library(
    name = "runtime",
    srcs = ["runtime.py"],
    visibility = ["//visibility:public"],
)

tl3_py_test(
    name = "test_runtime",
    srcs = ["test_runtime.py"],
)

filegroup(
    name = "workspace_build_files",
    srcs = ["//crates/" + crate + ":BUILD.bazel" for crate in [
        "config",
        "controller",
        "github",
        "kernel",
        "mergify",
        "prismabuild",
        "store",
        "worktrees",
    ]],
)

tl3_py_test(
    name = "test_rust_builds",
    srcs = ["test_rust_builds.py"],
    deps = [":rust_builds"],
)
