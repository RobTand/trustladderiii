# gazelle:ignore
# This external guard closure runs on PB with Git history, CAS and the safe reader.
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "fixture-check",
    srcs = ["fixture-check.py"],
    data = glob(["*.source", "*.json"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "install-source",
    srcs = ["dev_evidence.py.source", "pb_nightly.py.source"],
    visibility = ["//visibility:public"],
)
