class Run(NamedTuple):
    head: str
    tree: str
    source_hashes: dict
    driver_sha256: str
    output_root: str
    memory_gib: dict | None = None



class Refuse(ValueError):
    pass


def require(condition, message):
    if not condition:
        raise Refuse(message)


def unique(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, "duplicate JSON key")
        result[key] = value
    return result


def loads(raw):
    return json.loads(raw, object_pairs_hook=unique)


def git(repo, *args):
    return subprocess.check_output(["git", "-C", str(repo), *args], stderr=subprocess.DEVNULL, timeout=60)


def pinned_sources(repo, head):
    actual = {path: hashlib.sha256(git(repo, "show", head + ":" + path)).hexdigest()
              for path in POLICY_PINS}
    require(actual == POLICY_PINS, "reviewed nightly policy bytes changed")
    return {path: actual[path] for path in SOURCE_PATHS}


def frozen_policy(repo, head):
    pinned_sources(repo, head)
    # Execute only reviewed policy bytes at the exact commit.
    child = types.ModuleType("child_env")
    exec(compile(git(repo, "show", head + ":tools/ci/child_env.py"), "frozen-child-env", "exec"), child.__dict__)
    old = sys.modules.get("child_env")
    sys.modules["child_env"] = child
    try:
        gate = types.ModuleType("frozen_kani_gate")
        gate.__file__ = str(Path(repo) / "tools/ci/kani_gate.py")
        exec(compile(git(repo, "show", head + ":tools/ci/kani_gate.py"), "frozen-kani-gate", "exec"), gate.__dict__)
    finally:
        if old is None:
            sys.modules.pop("child_env", None)
        else:
            sys.modules["child_env"] = old
    budgets = loads(git(repo, "show", head + ":tools/ci/kani-budgets.json"))
    require(budgets["schema"] == "tl3.kani-budgets.v1", "budget schema mismatch")
    return gate, budgets["harnesses"]


def validate_leaf(name, evidence, artifacts, gate, budgets, run):
    require(evidence.get("schema") == "tl3.pb-kani-leaf.v1", "leaf schema mismatch")
    require(evidence.get("transport") == "prismabuild", "PB evidence cannot claim GitHub transport")
    require(evidence.get("head") == run.head and evidence.get("tree") == run.tree, "leaf source mismatch")
    require(evidence.get("harness") == name, "leaf harness mismatch")
    require(type(evidence.get("command_exit")) is int and evidence["command_exit"] == 0, "leaf command failed")
    require(evidence.get("source_clean_after") is True, "leaf source cleanliness missing")
    record = evidence["record"]
    require(record.get("schema") == gate.SCHEMA and record.get("head") == record.get("checkout") == run.head,
            "shard source/schema mismatch")
    require(record.get("mode") == "nightly" and record.get("harnesses") == [name], "shard scope mismatch")
    require(record.get("index") == evidence.get("index"), "shard index mismatch")
    require(record.get("error") is None and set(record.get("results", {})) == {name}, "incomplete or failed shard")
    require(loads(artifacts[gate.RESULT]) == record, "shard record differs from authenticated artifact")
    result = record["results"][name]
    require(result.get("name") == name and result.get("timeout") == gate.budget(name, budgets)["timeout"],
            "harness identity or frozen bound mismatch")
    text = artifacts["kani-logs/" + name + ".log"].decode(errors="replace")
    verdict = result.get("verdict")
    if verdict == "SUCCESSFUL":
        require(result.get("pending") == budgets[name].get("pending") and not result.get("outcome"),
                "pending cannot be promoted to success")
        raw = gate.verdict(text, 0, False)
        require(raw["verdict"] == "SUCCESSFUL" and raw["covers"] == result.get("covers"),
                "raw proof/cover results do not establish success")
    elif verdict == "PENDING":
        require(budgets[name].get("pending") == result.get("pending") == "#806", "unregistered pending result")
        require(result.get("outcome") in ("TIMEOUT", "KILLED"), "pending is not an allowed frozen outcome")
        require("VERIFICATION:- FAILED" not in text, "pending cannot hide a counterexample")
        require(result.get("outcome") != "TIMEOUT" or result.get("seconds", -1) >= result["timeout"],
                "pending timeout has no elapsed bound")
        raw = gate.verdict(text, 0, result["outcome"] == "TIMEOUT")
        require(raw["verdict"] == result["outcome"], "raw pending result contradicts frozen policy")
    else:
        raise Refuse("harness did not satisfy the frozen nightly policy")
    return result


def validate_index(index, budgets, read_leaf, run):
    require(index.get("errors") == [], "nightly aggregate has missing or nonempty errors")
    require(index.get("schema") == "tl3.pb-kani-nightly.v2", "index schema mismatch")
    require(index.get("head") == run.head and index.get("tree") == run.tree, "index must name its exact run commit")
    require(index.get("mode") == "nightly" and index.get("transport") == "prismabuild", "index transport/mode mismatch")
    require(index.get("driver_sha256") == run.driver_sha256, "index driver mismatch")
    rows = index.get("leaves")
    require(isinstance(rows, dict) and len(rows) == 78 and set(rows) == set(budgets), "not the complete frozen 78-harness inventory")
    require(all(isinstance(key, str) and re.fullmatch("[0-9a-f]{64}", key) for key in rows.values()), "invalid action key")
    require(len(set(rows.values())) == len(rows), "one action must not stand in for two harnesses")
    results = {}
    for i, name in enumerate(sorted(rows)):
        result = read_leaf(name, rows[name], i)
        require(result.get("name") == name, "collector returned another harness")
        results[name] = result
    return results


def terminal(key):
    raw = subprocess.check_output(["python3", "-I", READER, key, "--log", "--retained-output"], timeout=30).decode()
    fields = unique(line.split(": ", 1) for line in raw.splitlines() if ": " in line)
    require(fields.get("state") == "done" and fields.get("action_key") == key
            and fields.get("detail.returncode") == "0", "PB parent is not terminal done/0")
    require(loads(fields["resource_scope_cleanup.flags"]).get("complete") is True, "PB cleanup is not complete")
    return fields


PARAM_KEYS = {"checkout_snapshot", "command", "cwd", "demand", "execution_timeout_s", "placement", "retry_policy"}


def measured_peak(cas, name, key):
    raw = subprocess.check_output(["python3", "-I", READER, key, "--log", "--retained-output"], timeout=30).decode()
    fields = unique(line.split(": ", 1) for line in raw.splitlines() if ": " in line)
    require(fields.get("action_key") == key and fields.get("state") in ("done", "failed"),
            "sizing measurement is not terminal")
    require(fields.get("state") == "done" and fields.get("detail.returncode") == "0"
            and fields.get("detail.resource_telemetry.oom_kill") == "0",
            "resource failure is a lower bound, not a measured peak")
    require(loads(fields["resource_scope_cleanup.flags"]).get("complete") is True,
            "sizing measurement cleanup incomplete")
    action = cas.read_action_request(key)
    require(action is not None and set(action["params"]) == PARAM_KEYS, "sizing measurement action changed")
    params = action["params"]
    snapshot = params["checkout_snapshot"]
    require(snapshot.get("parent") == fields.get("checkout_snapshot.parent") == TEMPLATE_HEAD
            and snapshot.get("commit") == fields.get("checkout_snapshot.commit")
            and snapshot.get("subdirectory") == "."
            and snapshot["input"]["sha256"] == fields.get("checkout_snapshot.input.sha256"),
            "sizing measurement source mismatch")
    command = params["command"]
    require(len(command) == 14 and command[:7] == ["python3", "-B", "deploy/dl380g10/exact-source.py",
            TEMPLATE_HEAD, "python3", "-B", "-c"] and command[8] == "leaf" and command[10] == name
            and hashlib.sha256(command[7].encode()).hexdigest() == TEMPLATE_DRIVER_SHA256,
            "sizing measurement is not the original harness/driver")
    peak = fields.get("detail.resource_telemetry.memory_peak_bytes", "")
    require(re.fullmatch("[0-9]+", peak) and int(peak) > 0, "missing whole-scope sizing measurement")
    return int(peak)


def sizing_table(budgets, read_peak):
    require(set(budgets) == set(MEASUREMENT_KEYS) and len(budgets) == 78, "sizing inventory mismatch")
    rows = {}
    for name, policy in budgets.items():
        # All 78 frozen harnesses have measured BB peaks. The unmeasured-worker-slot
        # fallback is not exercised by this inventory and cannot invent a peak.
        historical = policy.get("peak_gb")
        require(type(historical) in (int, float) and math.isfinite(historical) and historical > 0,
                "no measured peak; largest admissible worker slot must be established before publication")
        peak = max(math.ceil(historical * 2**30), *(read_peak(name, key) for key in MEASUREMENT_KEYS[name]))
        reservation = (peak * 5 + 4 * 2**30 - 1) // (4 * 2**30)
        rows[name] = {"measured_peak_bytes": peak, "reservation_gib": reservation}
    return {"schema": "tl3.pb-kani-sizing.v1", "policy": "measured-peak-plus-25-percent", "leaves": rows}


def validate_sizing(table, budgets, cas):
    expected = sizing_table(budgets, lambda name, key: measured_peak(cas, name, key))
    require(table == expected, "campaign sizing differs from measured peak plus 25 percent")
    return {name: row["reservation_gib"] for name, row in table["leaves"].items()}


def validate_environment(variables):
    expected = {"HOME": "/home/rob", "PATH": PB_SOURCE.removesuffix("/src") + "/tools:/home/rob/.cargo/bin:/usr/bin:/bin",
                "PYTHONDONTWRITEBYTECODE": "1", "CARGO_BUILD_JOBS": "1", "OMP_NUM_THREADS": "1",
                "MKL_NUM_THREADS": "1", "OPENBLAS_NUM_THREADS": "1", "RAYON_NUM_THREADS": "1",
                "TOKIO_WORKER_THREADS": "1", "RUST_TEST_THREADS": "1", "CUDA_VISIBLE_DEVICES": ""}
    bookkeeping = {"PRISMABUILD_CONTAINER_MARKER", "PRISMABUILD_CONTAINER_OWNER"}
    require(set(variables) == set(expected) | bookkeeping
            and all(variables[key] == value for key, value in expected.items()),
            "PB proof environment differs from the sealed allowlist")


def source_verifier(cas, run):
    @functools.lru_cache(maxsize=8)
    def verify(input_digest, input_bytes, snapshot_commit):
        payload = cas.read_declared_blob({"sha256": input_digest, "bytes": input_bytes},
                                        max_bytes=512 * 1024 * 1024, where="PB nightly source bundle")
        with tempfile.TemporaryDirectory(prefix="tl3-pb-nightly-source-") as temp:
            root = Path(temp)
            bundle = root / "source.bundle"
            bundle.write_bytes(payload)
            repo = root / "source.git"
            subprocess.run(["git", "clone", "--quiet", "--bare", str(bundle), str(repo)], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
            require(git(repo, "rev-parse", run.head + "^{tree}").decode().strip() == run.tree, "frozen source tree mismatch")
            delta = git(repo, "diff", "--no-renames", "--name-only", run.head, snapshot_commit).decode().splitlines()
            require(len(delta) == 1 and re.fullmatch(r"\.pbrun-closure\.[0-9a-f]+\.json", delta[0]),
                    "unsealed source: snapshot differs beyond the PB stamp")
        return True
    return verify


def authenticated_leaf(cas, verify_source, gate, budgets, name, key, index, run):
    state = terminal(key)
    action = cas.read_action_request(key)
    require(action is not None, "missing sealed PB action")
    receipt = cas.lookup(action)
    require(receipt is not None and receipt.get("action_key") == key, "missing authenticated CAS receipt")
    params = action["params"]
    require(set(params) == PARAM_KEYS, "unexpected sealed PB action parameter")
    snapshot = params["checkout_snapshot"]
    require(snapshot.get("subdirectory") == ".", "PB source subdirectory mismatch")
    require(snapshot.get("parent") == state.get("checkout_snapshot.parent") == run.head, "unsealed or wrong PB source parent")
    require(snapshot.get("commit") == state.get("checkout_snapshot.commit"), "PB terminal source mismatch")
    require(snapshot["input"]["sha256"] == state.get("checkout_snapshot.input.sha256"), "PB terminal input mismatch")
    verify_source(snapshot["input"]["sha256"], snapshot["input"]["bytes"], snapshot["commit"])
    command = params["command"]
    require(command[:7] == ["python3", "-B", "deploy/dl380g10/exact-source.py", run.head, "python3", "-B", "-c"]
            and len(command) == 14, "not the frozen exact-source PB invocation")
    require(hashlib.sha256(command[7].encode()).hexdigest() == run.driver_sha256, "PB proof driver was changed")
    validate_driver(command[7], run)
    require(command[8] == "leaf" and command[10:12] == [name, str(index)], "PB leaf dispatch mismatch")
    require(loads(command[9]) == run.source_hashes and command[12] == run.output_root + "/" + name
            and command[13] == PB_SOURCE, "PB leaf input/output/runtime dependency mismatch")
    require(run.memory_gib is not None and name in run.memory_gib, "missing sealed memory reservation")
    memory = run.memory_gib[name]
    require(params["demand"] == {"cpu": 1, "mem_gb": memory}, "PB memory/CPU admission mismatch")
    require(params.get("execution_timeout_s") == 3600
            and params.get("placement") == {"required_tags": ["x86"]}
            and params.get("retry_policy") == {"max_attempts": 1, "retry_safe": False},
            "PB admission bound/placement/retry policy mismatch")
    validate_environment(action["environment"]["variables"])
    payload = cas.read_declared_blob(receipt["result"], max_bytes=16 * 1024 * 1024, where="PB nightly output")
    reference = loads(state["detail.stdout_log"])
    path = (QUEUE_ROOT / reference["path"]).resolve()
    require(path.is_relative_to(QUEUE_ROOT.resolve()), "PB log path escape")
    log = path.read_bytes()
    require(len(log) == reference["bytes"] and hashlib.sha256(log).hexdigest() == reference["sha256"]
            and payload in log, "PB terminal log differs from CAS output")
    markers = [loads(line[len(MARKER):]) for line in payload.decode().splitlines() if line.startswith(MARKER)]
    require(len(markers) == 1, "missing or ambiguous authenticated leaf evidence")
    evidence = markers[0]
    require(evidence.get("index") == index, "leaf evidence index mismatch")
    artifacts = {}
    for relative, ref in evidence["artifacts"].items():
        require(not Path(relative).is_absolute() and ".." not in Path(relative).parts, "artifact path escape")
        artifacts[relative] = cas.read_declared_blob(ref, max_bytes=256 * 1024 * 1024, where="PB nightly raw artifact")
    return validate_leaf(name, evidence, artifacts, gate, budgets, run)


def validate_driver(source, run):
    # Only the two identity literals may differ from the already-qualified driver.
    head_line = 'HEAD = "' + run.head + '"'
    tree_line = 'TREE = "' + run.tree + '"'
    require(source.splitlines().count(head_line) == source.splitlines().count(tree_line) == 1,
            "driver lacks its exact run identity")
    normalized = source.replace(head_line, 'HEAD = "' + TEMPLATE_HEAD + '"', 1)
    normalized = normalized.replace(tree_line, 'TREE = "' + TEMPLATE_TREE + '"', 1)
    require(hashlib.sha256(normalized.encode()).hexdigest() == TEMPLATE_DRIVER_SHA256,
            "PB proof driver changed beyond the two source identity literals")


def run_identity(repo, index, candidate_head):
    head, tree = index.get("head"), index.get("tree")
    require(isinstance(head, str) and re.fullmatch("[0-9a-f]{40}", head)
            and isinstance(tree, str) and re.fullmatch("[0-9a-f]{40}", tree), "invalid run Git identity")
    require(head == candidate_head, "same fingerprint cannot substitute another run commit")
    require(git(repo, "rev-parse", head + "^{tree}").decode().strip() == tree, "run tree mismatch")
    hashes = pinned_sources(repo, head)
    require(index.get("frozen_sources") == hashes, "run source pins differ from exact Git objects")
    correlation = index.get("correlation")
    require(isinstance(correlation, str) and re.fullmatch(
        r"ops-kani-nightly-[0-9]{8}T[0-9]{4}(?:[0-9]{2})?Z-" + head[:8], correlation),
        "invalid run output identity")
    driver = index.get("driver_sha256")
    require(isinstance(driver, str) and re.fullmatch("[0-9a-f]{64}", driver), "invalid run driver digest")
    return Run(head, tree, hashes, driver, "/mnt/shared/flux-out/tl3/" + correlation)


def proof(repo, fp_target, fingerprint, requested_head):
    candidate_head = git(repo, "rev-parse", "HEAD").decode().strip()
    require(re.fullmatch("[0-9a-f]{40}", candidate_head), "invalid candidate commit")
    path = INDEX_ROOT / candidate_head / "PB-NIGHTLY-INDEX.json"
    if not path.exists():
        return None
    require(candidate_head == requested_head, "requested candidate differs from exact-source HEAD")
    for directory in (INDEX_ROOT, path.parent):
        info = directory.lstat()
        require(stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid() and not info.st_mode & 0o022,
                "PB run directory must be private and owned")
    require(not any(parent.is_symlink() for parent in path.parents), "symlinked PB index ancestor")
    info = path.lstat()
    require(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) == 0o600
            and info.st_size <= 256 * 1024, "PB index must be an owned bounded private regular file")
    index_bytes = path.read_bytes()
    require(len(index_bytes) <= 256 * 1024, "PB index byte bound exceeded")
    index = loads(index_bytes)
    run = run_identity(repo, index, candidate_head)
    require(not git(repo, "status", "--porcelain=v1", "--untracked-files=all", "--ignored").strip(),
            "candidate source is dirty")
    require(fingerprint(repo, candidate_head) == fp_target, "PB nightly fingerprint mismatch")
    gate, budgets = frozen_policy(repo, run.head)
    sys.path.append(PB_SOURCE)
    from prismabuild.core import PrismaBuildCAS
    cas = PrismaBuildCAS(CAS_ROOT)
    reservations = validate_sizing(index.get("sizing"), budgets, cas)
    run = run._replace(memory_gib=reservations)
    verify_source = source_verifier(cas, run)
    validate_index(index, budgets,
                   lambda name, key, i: authenticated_leaf(cas, verify_source, gate, budgets, name, key, i, run), run)
    return "pb-nightly:" + hashlib.sha256(index_bytes).hexdigest(), run.head
