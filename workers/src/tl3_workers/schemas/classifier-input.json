{
  "$defs": {
    "ClassifierInputReconcileIssue": {
      "additionalProperties": true,
      "description": "Fresh GitHub issue, frozen before restart intake. Its current title and body override contradictory restored decisions.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "number": {
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "title",
        "body",
        "updated_at"
      ],
      "type": "object"
    },
    "ClassifierState": {
      "additionalProperties": false,
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "open_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClassifierStateOpenQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "minLength": 1,
          "type": "string"
        },
        "restartable": {
          "type": "boolean"
        }
      },
      "required": [
        "phase",
        "closed"
      ],
      "type": "object"
    },
    "ClassifierStateOpenQuestion": {
      "additionalProperties": false,
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/ClassifierStateOpenQuestionAnswersItem"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ClassifierStateOpenQuestionKind"
        }
      },
      "required": [
        "id",
        "kind",
        "answers"
      ],
      "type": "object"
    },
    "ClassifierStateOpenQuestionAnswersItem": {
      "enum": [
        "continue",
        "change_request",
        "stop",
        "try_again",
        "add_credit",
        "retry",
        "mark_handled"
      ],
      "type": "string"
    },
    "ClassifierStateOpenQuestionKind": {
      "enum": [
        "audit_disagreement",
        "needs_splitting",
        "cant_meet",
        "out_of_credit",
        "effect_failed",
        "cleanup_cant_finish",
        "unclear_answer"
      ],
      "type": "string"
    },
    "Comment": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "minLength": 1,
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "delegated_by": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "author",
        "body"
      ],
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "decisions": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "maxItems": 64,
          "type": "array"
        },
        "request_version": {
          "minimum": 0,
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "request_version",
        "decisions"
      ],
      "type": "object"
    },
    "Conversation": {
      "additionalProperties": false,
      "properties": {
        "comment": {
          "type": "string"
        },
        "comment_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "comment_id",
        "comment",
        "question"
      ],
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "allowed_scope": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "answer": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "origin_request_version": {
          "minimum": 0,
          "type": "integer"
        },
        "question": {
          "additionalProperties": true,
          "type": "object"
        },
        "restrictions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "source_comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "superseded_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersession_reason": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_comment",
        "question",
        "answer",
        "allowed_scope",
        "restrictions",
        "origin_request_version",
        "superseded_by"
      ],
      "type": "object"
    }
  },
  "$id": "https://trustladderiii.invalid/workers/protocol-1/classifier-input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comment": {
      "$ref": "#/$defs/Comment"
    },
    "conversation": {
      "$ref": "#/$defs/Conversation"
    },
    "decision_context": {
      "$ref": "#/$defs/Context",
      "description": "Controller-recorded decisions applicable to this request version. Source answers define scope and restrictions; they do not grant tools or override protected paths."
    },
    "question_context": {
      "additionalProperties": true,
      "description": "The complete current question and findings whose option Rob is answering.",
      "type": "object"
    },
    "reconcile_issue": {
      "$ref": "#/$defs/ClassifierInputReconcileIssue",
      "description": "Fresh GitHub issue, frozen before restart intake. Its current title and body override contradictory restored decisions."
    },
    "selected_answer": {
      "$ref": "classifier-reply.json",
      "description": "A typed console choice. Copy these fields exactly; assess only its decision details and supersedes."
    },
    "state": {
      "$ref": "#/$defs/ClassifierState"
    }
  },
  "required": [
    "comment",
    "state"
  ],
  "type": "object"
}
