{
  "$defs": {
    "strings": {
      "items": {
        "$ref": "#/$defs/text"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "text": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    }
  },
  "$id": "https://trustladderiii.invalid/workers/protocol-1/maker-input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "round": {
        "const": 1
      }
    }
  },
  "properties": {
    "attempt": {
      "maximum": 3,
      "minimum": 1,
      "type": "integer"
    },
    "brief": {
      "$ref": "#/$defs/text"
    },
    "check_base_sha": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "context_size": {
      "minimum": 1,
      "type": "integer"
    },
    "current_review_findings": {
      "items": {
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "reviewed_sha": {
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "decision_context": {
      "$ref": "decision-context.json"
    },
    "feedback": {
      "items": {
        "additionalProperties": false,
        "dependentRequired": {
          "id": [
            "reviewed_sha"
          ],
          "reviewed_sha": [
            "id"
          ]
        },
        "properties": {
          "ci_checks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/text"
                },
                "summary": {
                  "$ref": "#/$defs/text",
                  "maxLength": 1000
                },
                "url": {
                  "maxLength": 4096,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "summary",
                "url"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          },
          "failed_tests": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "message": {
                  "$ref": "#/$defs/text",
                  "maxLength": 65536
                },
                "test": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "test",
                "message"
              ],
              "type": "object"
            },
            "maxItems": 20,
            "type": "array"
          },
          "goal_ids": {
            "items": {
              "$ref": "#/$defs/text"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "enum": [
              "failed_check",
              "review_finding"
            ]
          },
          "outside_paths": {
            "items": {
              "$ref": "#/$defs/text",
              "maxLength": 4096
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "outside_paths_total": {
            "minimum": 0,
            "type": "integer"
          },
          "report": {
            "$ref": "#/$defs/text",
            "maxLength": 16000
          },
          "resolved_round": {
            "minimum": 1,
            "type": "integer"
          },
          "reviewed_sha": {
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "report",
          "goal_ids"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "footprint": {
      "items": {
        "minLength": 1,
        "not": {
          "pattern": "(^|/)(\\.|\\.\\.|\\.git)(/|$)"
        },
        "pattern": "^[^/\\\\\\u0000]+(/[^/\\\\\\u0000]+)*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "forecast": {
      "$ref": "planner-input.json#/properties/forecast"
    },
    "goals": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "required": [
                  "publication"
                ]
              }
            },
            "if": {
              "properties": {
                "stage": {
                  "const": "publishing"
                }
              },
              "required": [
                "stage"
              ]
            },
            "then": {
              "required": [
                "publication"
              ]
            }
          }
        ],
        "properties": {
          "description": {
            "$ref": "#/$defs/text"
          },
          "id": {
            "$ref": "#/$defs/text"
          },
          "proof_obligation": {
            "$ref": "ingest-reply.json#/$defs/proof_obligation"
          },
          "publication": {
            "additionalProperties": false,
            "properties": {
              "body_lines": {
                "items": {
                  "maxLength": 512,
                  "minLength": 1,
                  "pattern": "^[^\\r\\n]+$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "branch": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "branch_prefix": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "non_draft": {
                "const": true
              },
              "proof": {
                "type": "boolean"
              }
            },
            "required": [
              "non_draft",
              "body_lines",
              "proof"
            ],
            "type": "object"
          },
          "stage": {
            "enum": [
              "maker",
              "checking",
              "publishing"
            ]
          },
          "verification": {
            "enum": [
              "test",
              "review"
            ]
          }
        },
        "required": [
          "id",
          "description"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "hindsight": {
      "additionalProperties": false,
      "properties": {
        "bank": {
          "$ref": "#/$defs/text"
        },
        "endpoint": {
          "pattern": "^https?://",
          "type": "string"
        }
      },
      "required": [
        "endpoint",
        "bank"
      ],
      "type": "object"
    },
    "plan": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "declared_symptom": {
                "additionalProperties": false,
                "properties": {
                  "exception": {
                    "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)+$",
                    "type": "string"
                  },
                  "node": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "parallel": {
                    "enum": [
                      0,
                      2,
                      3,
                      4
                    ]
                  },
                  "phase": {
                    "enum": [
                      "call",
                      "setup"
                    ],
                    "type": "string"
                  },
                  "repeat": {
                    "maximum": 10,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "node",
                  "exception",
                  "phase",
                  "repeat",
                  "parallel"
                ],
                "type": "object"
              },
              "forcing": {
                "additionalProperties": false,
                "description": "A forced reproduction (#393): the declarative condition the harness applies, outside the test, to recreate a flake. Only on demonstrating checks.",
                "properties": {
                  "environment": {
                    "additionalProperties": {
                      "maxLength": 1000,
                      "type": "string"
                    },
                    "maxProperties": 8,
                    "propertyNames": {
                      "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
                    },
                    "type": "object"
                  },
                  "patches": {
                    "items": {
                      "additionalProperties": false,
                      "maxProperties": 2,
                      "minProperties": 2,
                      "properties": {
                        "delay_seconds": {
                          "exclusiveMinimum": 0,
                          "maximum": 5,
                          "type": "number"
                        },
                        "raises": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "returns": {},
                        "target": {
                          "maxLength": 200,
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$",
                          "type": "string"
                        },
                        "value": {}
                      },
                      "required": [
                        "target"
                      ],
                      "type": "object"
                    },
                    "maxItems": 8,
                    "type": "array"
                  },
                  "symptom": {
                    "maxLength": 1000,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "symptom",
                  "environment",
                  "patches"
                ],
                "type": "object"
              },
              "goal_ids": {
                "description": "Original ingest.goals indices. Required, unique, never renumbered across splits.\nThe planner gate checks nonempty/range/coverage; controller controls explicitly use [].",
                "items": {
                  "description": "Original zero-based index in request.inputs.ingest.goals, retained across splits.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "type": "array",
                "uniqueItems": true
              },
              "kind": {
                "enum": [
                  "demonstrating",
                  "regression",
                  "behavior-preserving",
                  "reproducing"
                ],
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "proof": {
                "additionalProperties": false,
                "properties": {
                  "observer_support": {
                    "items": {
                      "maxLength": 1000,
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|::|$))[^\\\\\\u0000\\r\\n]+\\.py(?:::[A-Za-z_][A-Za-z_0-9]*)*$",
                      "type": "string"
                    },
                    "maxItems": 16,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "red_message": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string"
                  },
                  "subjects": {
                    "items": {
                      "maxLength": 1000,
                      "minLength": 1,
                      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|::|$))[^\\\\\\u0000\\r\\n]+\\.py(?:::[A-Za-z_][A-Za-z_0-9]*)*$",
                      "type": "string"
                    },
                    "maxItems": 16,
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "required": [
                  "subjects",
                  "observer_support",
                  "red_message"
                ],
                "type": "object"
              },
              "tests": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "goal_ids",
              "kind",
              "tests"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "files": {
          "$ref": "#/$defs/strings"
        }
      },
      "required": [
        "files",
        "checks"
      ],
      "type": "object"
    },
    "protected_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "reviewed_sha": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "round": {
      "enum": [
        0,
        1
      ],
      "type": "integer"
    },
    "tests": {
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "minimum": 1,
          "type": "integer"
        },
        "execution": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "backend": {
                  "const": "flux",
                  "type": "string"
                },
                "profile": {
                  "pattern": "^/",
                  "type": "string"
                }
              },
              "required": [
                "backend",
                "profile"
              ],
              "type": "object"
            }
          ]
        },
        "image": {
          "pattern": "^(?:[\\w./:-]+@)?sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "mem_gb": {
          "minimum": 1,
          "type": "integer"
        },
        "quiet_seconds": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "image",
        "execution"
      ],
      "type": "object"
    }
  },
  "required": [
    "brief",
    "goals",
    "plan",
    "footprint",
    "attempt",
    "round",
    "tests",
    "context_size"
  ],
  "then": {
    "required": [
      "feedback"
    ]
  },
  "type": "object"
}
