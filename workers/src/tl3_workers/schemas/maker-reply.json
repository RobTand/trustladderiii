{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/maker-reply.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {"const": "done"},
        "head": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$", "description": "Added by worker code. The model must omit this field."},
        "reproductions": {"type": "array", "items": {"$ref": "#/$defs/reproduction"}},
        "self_check": {
          "type": "array", "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {"goal_id": {"$ref": "#/$defs/text"}, "status": {"const": "met"}, "evidence": {"$ref": "#/$defs/text"}},
                "required": ["goal_id", "status", "evidence"], "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {"goal_id": {"$ref": "#/$defs/text"}, "status": {"const": "not_met"}, "why": {"$ref": "#/$defs/text"}},
                "required": ["goal_id", "status", "why"], "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["kind", "self_check", "head"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {"const": "needs_files"},
        "fits": {"type": "boolean", "description": "Added by worker code. The model must omit this field."},
        "files": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {"path": {"$ref": "#/$defs/text"}, "why": {"$ref": "#/$defs/text"}},
            "required": ["path", "why"], "additionalProperties": false
          }
        }
      },
      "required": ["kind", "files"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {"kind": {"const": "cant_meet"}, "report": {"$ref": "#/$defs/text"}},
      "required": ["kind", "report"], "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {"const": "blocked"},
        "evidence": {
          "description": "An action_key whose run_tests summary had status infrastructure_error, or a tool_error id, recorded in this run.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "action_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "class": {"const": "test_infrastructure", "description": "Added by worker code. The model must omit this field."}
              },
              "required": ["action_key", "class"], "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "tool_error": {"type": "string", "pattern": "^tool-error-[1-9][0-9]*$"},
                "tool": {"enum": ["list", "read", "glob", "grep", "write", "edit", "run_tests", "recall"], "description": "Added by worker code. The model must omit this field."},
                "class": {"enum": ["test_submission", "EACCES", "EPERM", "EROFS", "ENOSPC", "EDQUOT", "EIO", "EMFILE", "ENFILE", "ENOMEM"], "description": "Added by worker code. The model must omit this field."}
              },
              "required": ["tool_error", "tool", "class"], "additionalProperties": false
            }
          ]
        },
        "report": {"$ref": "#/$defs/text"}
      },
      "required": ["kind", "evidence", "report"], "additionalProperties": false
    },
    {
      "type": "object", "properties": {"kind": {"const": "out_of_room"}},
      "required": ["kind"], "additionalProperties": false
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "reproduction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "finding_id": {"$ref": "#/$defs/text"},
            "tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
          },
          "required": ["finding_id", "tests"], "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {"finding_id": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}},
          "required": ["finding_id", "reason"], "additionalProperties": false
        }
      ]
    }
  }
}
