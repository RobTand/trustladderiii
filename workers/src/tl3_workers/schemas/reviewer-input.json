      "additionalProperties": false,
      "properties": {
        "observer_support": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|::|$))[^\\\\\\u0000\\r\\n]+\\.py(?:::[A-Za-z_][A-Za-z_0-9]*)*$",
