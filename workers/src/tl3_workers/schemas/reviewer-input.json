{
  "$defs": {
    "CheckKind": {
      "enum": [
        "demonstrating",
        "regression",
        "behavior-preserving",
        "reproducing"
      ],
      "type": "string"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "custody": {
          "$ref": "#/$defs/Custody"
        },
        "declared_symptom": {
          "$ref": "#/$defs/DeclaredSymptom"
        },
        "forcing": {
          "$ref": "#/$defs/Forcing"
        },
        "kind": {
          "$ref": "#/$defs/CheckKind"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "proof": {
          "$ref": "#/$defs/ProofReceipt"
        },
        "selection": {
          "$ref": "#/$defs/Selection"
        },
        "symptom_evidence": {
          "$ref": "#/$defs/SymptomEvidence"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/TestResult"
          },
          "minItems": 1,
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "name",
        "kind",
        "verdict",
        "custody",
        "tests"
      ],
      "type": "object"
    },
    "CollectionSaturation": {
      "additionalProperties": false,
      "properties": {
        "cases": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "remaining": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "type": "integer"
        },
        "unit": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "unit",
        "cases",
        "remaining"
      ],
      "type": "object"
    },
    "Custody": {
      "enum": [
        "in-process"
      ],
      "type": "string"
    },
    "DeclaredSymptom": {
      "additionalProperties": false,
      "properties": {
        "exception": {
          "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)+$",
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "type": "string"
        },
        "parallel": {
          "enum": [
            0,
            2,
            3,
            4
          ]
        },
        "phase": {
          "$ref": "#/$defs/SymptomPhase"
        },
        "repeat": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "node",
        "exception",
        "phase",
        "repeat",
        "parallel"
      ],
      "type": "object"
    },
    "DelayBudget": {
      "additionalProperties": false,
      "properties": {
        "applied_seconds": {
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        "exhausted": {
          "type": "boolean"
        }
      },
      "required": [
        "applied_seconds",
        "exhausted"
      ],
      "type": "object"
    },
    "Forcing": {
      "additionalProperties": false,
      "description": "A forced reproduction (#393): the declarative condition the harness applies, outside the test, to recreate a flake. Only on demonstrating checks.",
      "properties": {
        "environment": {
          "additionalProperties": {
            "maxLength": 1000,
            "type": "string"
          },
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "patches": {
          "items": {
            "additionalProperties": false,
            "maxProperties": 2,
            "minProperties": 2,
            "properties": {
              "delay_seconds": {
                "exclusiveMinimum": 0,
                "maximum": 5,
                "type": "number"
              },
              "raises": {
                "minLength": 1,
                "type": "string"
              },
              "returns": {},
              "target": {
                "maxLength": 200,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$",
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": "array"
        },
        "symptom": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "symptom",
        "environment",
        "patches"
      ],
      "type": "object"
    },
    "ForcingRefusal": {
      "additionalProperties": false,
      "properties": {
        "owner_category": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/ForcingValidation"
        },
        "reason": {
          "type": "string"
        },
        "resolved_module": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "phase",
        "target",
        "resolved_module",
        "owner_category",
        "reason"
      ],
      "type": "object"
    },
    "ForcingValidation": {
      "enum": [
        "forcing_validation"
      ],
      "type": "string"
    },
    "Goal": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "publication"
              ]
            }
          },
          "if": {
            "properties": {
              "stage": {
                "const": "publishing"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "required": [
              "publication"
            ]
          }
        }
      ],
      "properties": {
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "proof_obligation": {
          "$ref": "ingest-reply.json#/$defs/proof_obligation"
        },
        "publication": {
          "$ref": "#/$defs/GoalPublication"
        },
        "stage": {
          "$ref": "#/$defs/GoalStage"
        },
        "verification": {
          "$ref": "#/$defs/GoalVerification"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "GoalPublication": {
      "additionalProperties": false,
