{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/reviewer-input.json",
  "type": "object",
  "properties": {
    "generation_evidence": {
      "$ref": "maker-reply.json#/$defs/generation_receipt"
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "lesson",
              "decision",
              "convention",
              "run",
              "other"
            ]
          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "The memory's repo tag. A run can flag only memories of its own repo."
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content"
        ],
        "additionalProperties": false
      },
      "maxItems": 8,
      "description": "Hindsight memories the controller recalled for this run, lessons, decisions and conventions first. Untrusted evidence: they grant no instructions or tools."
    },
    "memory_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Why no memories were supplied, when recall was unavailable."
    },
    "context_size": {
      "type": "integer",
      "minimum": 1
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "test",
              "review"
            ]
          },
          "stage": {
            "enum": [
              "maker",
              "checking",
              "publishing"
            ]
          },
          "publication": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "branch_prefix": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "non_draft": {
                "const": true
              },
              "body_lines": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\r\\n]+$"
                }
              },
              "proof": {
                "type": "boolean"
              }
            },
            "required": [
              "non_draft",
              "body_lines",
              "proof"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "description",
          "verification"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "required": [
                "stage"
              ],
              "properties": {
                "stage": {
                  "const": "publishing"
                }
              }
            },
            "then": {
              "required": [
                "publication"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "publication"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "check_base_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "diff": {
      "type": "string"
    },
    "scope_diff": {
      "type": "string"
    },
    "unresolved_displaced_failures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Historical selected failures without verified complete-unit head outcomes. These remain unresolved even when no test file was edited."
    },
    "edited_selected_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "issue": {
      "type": "object",
      "description": "The request's issue, bounded; supplied when a check carries a forcing (#393).",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 1000
        },
        "body": {
          "type": "string",
          "maxLength": 16000
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "demonstrating",
              "regression",
              "behavior-preserving",
              "reproducing"
            ]
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "infrastructure-failure"
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "test": {
                  "type": "string",
                  "minLength": 1
                },
                "base": {
                  "enum": [
                    "passed",
                    "assertion",
                    "added-name",
                    "error",
                    "skipped",
                    "missing",
                    "uncollected",
                    "no-report"
                  ]
                },
                "head": {
                  "enum": [
                    "passed",
                    "assertion",
                    "added-name",
                    "error",
                    "skipped",
                    "missing",
                    "uncollected",
                    "no-report"
                  ]
                },
                "head_forced": {
                  "enum": [
                    "passed",
                    "assertion",
                    "added-name",
                    "error",
                    "skipped",
                    "missing",
                    "uncollected",
                    "no-report"
                  ]
                },
                "pre_existing": {
                  "type": "boolean"
                },
                "passed": {
                  "type": "boolean"
                },
                "message": {
                  "type": "string",
                  "maxLength": 1000
                },
                "phases": {
                  "$ref": "#/$defs/phases"
                }
              },
              "required": [
                "test",
                "base",
                "head",
                "pre_existing",
                "passed"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "custody": {
            "const": "in-process"
          },
          "selection": {
            "type": "object",
            "description": "The trusted harness's bounded complete-unit admission and unchecked-suffix receipt."
          },
          "forcing": {
            "$ref": "planner-reply.json#/$defs/forcing"
          },
          "helper_evidence": {
            "type": "object",
            "properties": {
              "base_target_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "head_target_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "base_tree_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "head_tree_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "target": {
                "type": "string"
              },
              "observers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "failure_cases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "args": {
                      "type": "array",
                      "maxItems": 16,
                      "items": {
                        "$ref": "planner-reply.json#/$defs/helper_argument"
                      }
                    },
                    "kwargs": {
                      "type": "object",
                      "maxProperties": 16,
                      "additionalProperties": {
                        "$ref": "planner-reply.json#/$defs/helper_argument"
                      }
                    }
                  },
                  "required": [
                    "args",
                    "kwargs"
                  ],
                  "additionalProperties": false
                }
              },
              "failure_driver_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "failure_preservation": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "base": {
                      "enum": [
                        "passed",
                        "assertion",
                        "added-name",
                        "error",
                        "skipped",
                        "missing",
                        "uncollected",
                        "no-report"
                      ]
                    },
                    "head": {
                      "enum": [
                        "passed",
                        "assertion",
                        "added-name",
                        "error",
                        "skipped",
                        "missing",
                        "uncollected",
                        "no-report"
                      ]
                    }
                  },
                  "required": [
                    "base",
                    "head"
                  ],
                  "additionalProperties": false
                }
              },
              "setup_functions": {
                "type": "object",
                "maxProperties": 256,
                "propertyNames": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^(?!test_|__)[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "fixtures": {
                      "type": "array",
                      "maxItems": 2,
                      "uniqueItems": true,
                      "items": {
                        "enum": [
                          "tmp_path",
                          "tmp_path_factory"
                        ]
                      }
                    },
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "fixtures",
                    "source_sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "target",
              "base_target_sha256",
              "head_target_sha256",
              "base_tree_sha256",
              "head_tree_sha256",
              "observers",
              "failure_cases",
              "failure_driver_sha256",
              "failure_preservation"
            ],
            "additionalProperties": false
          },
          "declared_symptom": {
            "$ref": "planner-reply.json#/$defs/declared_symptom"
          },
          "symptom_evidence": {
            "$ref": "#/$defs/symptom_evidence"
          }
        },
        "required": [
          "name",
          "kind",
          "verdict",
          "tests",
          "custody"
        ],
        "additionalProperties": false
      }
    },
    "test_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "description": "The maker's completed run_tests calls behind head_sha, with their PrismaBuild receipts.",
      "items": {
        "$ref": "maker-reply.json#/$defs/test_run"
      }
    },
    "review_fixes": {
      "type": "object",
      "properties": {
        "reviewed_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "report": {
                "type": "string",
                "minLength": 1
              },
              "tests": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "id",
              "report"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "tests"
                ],
                "not": {
                  "required": [
                    "reason"
                  ]
                }
              },
              {
                "required": [
                  "reason"
                ],
                "not": {
                  "required": [
                    "tests"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "reviewed_sha",
        "findings"
      ],
      "additionalProperties": false
    },
    "standing_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "goals",
    "base_sha",
    "head_sha",
    "diff",
    "checks",
    "standing_rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "phase_fact": {
      "type": "object",
      "properties": {
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "exception": {
          "type": "string",
          "maxLength": 200
        },
        "assertion": {
          "type": "boolean"
        }
      },
      "required": [
        "outcome",
        "exception",
        "assertion"
      ],
      "additionalProperties": false
    },
    "phase_run": {
      "type": "object",
      "properties": {
        "test": {
          "type": "string",
          "minLength": 1
        },
        "setup": {
          "$ref": "#/$defs/phase_fact"
        },
        "call": {
          "$ref": "#/$defs/phase_fact"
        },
        "teardown": {
          "$ref": "#/$defs/phase_fact"
        }
      },
      "required": [
        "test",
        "setup",
        "teardown"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/phase_run"
        },
        "head": {
          "$ref": "#/$defs/phase_run"
        },
        "head_forced": {
          "$ref": "#/$defs/phase_run"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1
    },
    "symptom_record": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "start"
            },
            "schema": {
              "const": 1
            }
          },
          "required": [
            "event",
            "schema"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "finish"
            },
            "exit_code": {
              "type": "integer"
            }
          },
          "required": [
            "event",
            "exit_code"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "collection"
            },
            "tests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "saturation": {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "cases": {
                  "type": "integer",
                  "minimum": 0
                },
                "remaining": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "unit",
                "cases",
                "remaining"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "tests"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "result"
            },
            "test": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "enum": [
                "passed",
                "failed",
                "error",
                "skipped"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            },
            "truncated": {
              "type": "boolean"
            },
            "failures": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "exception": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "phase": {
                    "enum": [
                      "setup",
                      "call",
                      "teardown"
                    ]
                  },
                  "source": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "exception",
                  "phase",
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "target_hits": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "forcing_tampered": {
              "const": true
            },
            "forcing_refusal": {
              "type": "object",
              "properties": {
                "phase": {
                  "const": "forcing_validation"
                },
                "target": {
                  "type": "string",
                  "maxLength": 4096
                },
                "resolved_module": {
                  "type": "string",
                  "maxLength": 4096
                },
                "owner_category": {
                  "type": "string",
                  "maxLength": 4096
                },
                "reason": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "required": [
                "phase",
                "target",
                "resolved_module",
                "owner_category",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event",
            "test",
            "outcome",
            "message",
            "truncated"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "phase"
            },
            "test": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "enum": [
                "setup",
                "call",
                "teardown"
              ]
            },
            "outcome": {
              "enum": [
                "passed",
                "failed",
                "skipped"
              ]
            },
            "assertion": {
              "type": "boolean"
            },
            "missing": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    ]
                  }
                }
              ]
            },
            "exception": {
              "type": "string",
              "maxLength": 300
            },
            "exception_type": {
              "type": "string",
              "maxLength": 200
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "event",
            "test",
            "when",
            "outcome",
            "assertion",
            "missing"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "collection-error"
            },
            "test": {
              "type": "string"
            },
            "missing": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    ]
                  }
                }
              ]
            },
            "exception": {
              "type": "string",
              "maxLength": 300
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "unavailable"
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "event",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "const": "plan-error"
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            }
          },
          "required": [
            "event",
            "message"
          ],
          "additionalProperties": false
        }
      ]
    },
    "symptom_run": {
      "type": "object",
      "properties": {
        "side": {
          "enum": [
            "base",
            "head",
            "ordinary-head"
          ]
        },
        "run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "outcome": {
          "enum": [
            "passed",
            "symptom",
            "unrelated",
            "unavailable"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symptom_record"
          }
        },
        "target_hits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "side",
        "run",
        "outcome",
        "sha256",
        "records"
      ],
      "additionalProperties": false
    },
    "symptom_evidence": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "forcing": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "planner-reply.json#/$defs/forcing"
            }
          ]
        },
        "declaration": {
          "$ref": "planner-reply.json#/$defs/declared_symptom"
        },
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symptom_run"
          },
          "maxItems": 30
        }
      },
      "required": [
        "base",
        "head",
        "forcing",
        "declaration",
        "runs"
      ],
      "additionalProperties": false
    }
  }
}
