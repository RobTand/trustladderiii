{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/postmortem-reply.json",
  "description": "A judged postmortem (#403). The judge writes `postmortem`; worker code adds the grades, assessment ids, usage and models.",
  "type": "object",
  "properties": {
    "postmortem": {"$ref": "#/$defs/postmortem"},
    "grades": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "dimension": {"type": "string", "minLength": 1, "maxLength": 100},
          "grade": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
          "rationale": {"type": "string", "maxLength": 4000},
          "judge_model": {"type": "string", "minLength": 1, "maxLength": 200},
          "assessment_id": {"type": ["string", "null"], "maxLength": 200}
        },
        "required": ["dimension", "grade", "rationale", "judge_model", "assessment_id"],
        "additionalProperties": false
      }
    },
    "assessment_ids": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    },
    "usage": {
      "type": "object",
      "properties": {
        "traces": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cache_read_input_tokens": {"type": "integer", "minimum": 0},
        "cache_creation_input_tokens": {"type": "integer", "minimum": 0}
      },
      "required": ["traces", "input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"],
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "postmortem": {"type": "string", "minLength": 1, "maxLength": 200},
        "grades": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "required": ["postmortem", "grades"],
      "additionalProperties": false
    }
  },
  "required": ["postmortem", "grades", "assessment_ids", "usage", "models"],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "postmortem": {
      "type": "object",
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "cause": {"enum": ["tl3", "outside"]},
        "went_wrong": {"type": "string", "maxLength": 8000},
        "timeline": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "type": "object",
            "properties": {
              "at": {"type": "string", "maxLength": 64},
              "event": {"type": "string", "minLength": 1, "maxLength": 1000}
            },
            "required": ["at", "event"],
            "additionalProperties": false
          }
        },
        "process_failures": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "phase": {"type": "string", "minLength": 1, "maxLength": 200},
              "kind": {"enum": ["prompt or skill defect", "code defect", "tool failure", "missing evidence"]},
              "what": {"$ref": "#/$defs/text"},
              "evidence": {"type": "string", "maxLength": 2000}
            },
            "required": ["phase", "kind", "what", "evidence"],
            "additionalProperties": false
          }
        },
        "recommendations": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/recommendation"}
        },
        "notes": {"type": "string", "maxLength": 2000},
        "lessons": {
          "type": "array",
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      },
      "required": ["summary", "cause", "went_wrong", "timeline", "process_failures", "recommendations", "notes", "lessons"],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "phase": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["prompt", "code", "config", "rule"]},
        "target": {"type": "string", "minLength": 1, "maxLength": 500},
        "operation": {"enum": ["add", "remove", "replace"]},
        "before": {"type": "string", "maxLength": 8000},
        "after": {"type": "string", "maxLength": 8000},
        "evidence": {"$ref": "#/$defs/text"},
        "effect": {"$ref": "#/$defs/text"}
      },
      "required": ["phase", "kind", "target", "operation", "before", "after", "evidence", "effect"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "add"}}},
          "then": {"properties": {"before": {"maxLength": 0}, "after": {"minLength": 1}}}
        },
        {
          "if": {"properties": {"operation": {"const": "remove"}}},
          "then": {"properties": {"before": {"minLength": 1}, "after": {"maxLength": 0}}}
        },
        {
          "if": {"properties": {"operation": {"const": "replace"}}},
          "then": {"properties": {"before": {"minLength": 1}, "after": {"minLength": 1}}}
        }
      ]
    }
  }
}
