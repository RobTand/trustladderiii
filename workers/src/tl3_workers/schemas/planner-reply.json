{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/planner-reply.json",
  "$defs": {
    "execution": {
      "type": "object",
      "properties": {
        "allowed_tool_turns": {
          "type": "integer",
          "minimum": 0
        },
        "finalization_turns": {
          "type": "integer",
          "minimum": 0
        },
        "usable_tool_turns": {
          "type": "integer",
          "minimum": 0
        },
        "estimated_tool_turns": {
          "type": "integer",
          "minimum": 0
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "exploration_declared": {
          "type": "boolean"
        },
        "fits": {
          "type": "boolean"
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/execution"
          }
        },
        "aggregate_tool_turns": {
          "type": "integer",
          "minimum": 0
        },
        "aggregate_allowed_tool_turns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "allowed_tool_turns",
        "finalization_turns",
        "usable_tool_turns",
        "estimated_tool_turns",
        "components",
        "exploration_declared",
        "fits"
      ],
      "additionalProperties": false,
      "description": "Code-owned execution estimate. Does not replace the exact token forecast or grant fresh maker allowance."
    },
    "forecast": {
      "type": "object",
      "properties": {
        "tokenizer": {
          "const": "o200k_base"
        },
        "brief_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "file_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "overhead_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "fit_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "fits": {
          "type": "boolean"
        }
      },
      "required": [
        "tokenizer",
        "brief_tokens",
        "file_tokens",
        "overhead_tokens",
        "tokens",
        "fit_tokens",
        "context_tokens",
        "fits"
      ],
      "additionalProperties": false,
      "description": "Appended by the reply check. The model must omit this field."
    },
    "forcing": {
      "type": "object",
      "description": "A forced reproduction (#393): the declarative condition the harness applies, outside the test, to recreate a flake. Only on demonstrating checks.",
      "properties": {
        "symptom": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "environment": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "patches": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
              },
              "value": {},
              "returns": {},
              "raises": {
                "type": "string",
                "minLength": 1
              },
              "delay_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "target"
            ],
            "minProperties": 2,
            "maxProperties": 2,
            "additionalProperties": false
          }
        }
      },
      "required": [
        "symptom",
        "environment",
        "patches"
      ],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|::|$))[^\\\\\\u0000\\r\\n]+\\.py(?:::[A-Za-z_][A-Za-z_0-9]*)*$"
          }
        },
        "observer_support": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|::|$))[^\\\\\\u0000\\r\\n]+\\.py(?:::[A-Za-z_][A-Za-z_0-9]*)*$"
          }
        },
        "red_message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "subjects",
        "observer_support",
        "red_message"
      ]
    },
    "declared_symptom": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "exception": {
          "type": "string",
          "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)+$"
        },
        "phase": {
          "enum": [
            "call",
            "setup"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "parallel": {
          "enum": [
            0,
            2,
            3,
            4
          ]
        }
      },
      "required": [
        "node",
        "exception",
        "phase",
        "repeat",
        "parallel"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "estimated_exploration_turns": {
          "type": "integer",
          "minimum": 0,
          "description": "Required for accepted leaves and splits. Estimate orientation reads, searches, globs and recall separately from implementation and proof. Zero must be explicit."
        },
        "estimated_tool_turns": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimate all required tool work, including proof, metadata and final verification. Code may increase this estimate."
        },
        "execution": {
          "$ref": "#/$defs/execution",
          "description": "Appended by worker code. The model must omit this field."
        },
        "kind": {
          "const": "leaf"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "demonstrating",
                  "regression",
                  "behavior-preserving"
                ]
              },
              "node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "goal_ids": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 0,
                "uniqueItems": true,
                "description": "Zero-based positions in inputs.ingest.goals."
              },
              "forcing": {
                "$ref": "#/$defs/forcing"
              },
              "proof": {
                "$ref": "#/$defs/proof"
              },
              "declared_symptom": {
                "$ref": "#/$defs/declared_symptom"
              }
            },
            "required": [
              "kind",
              "node_ids",
              "goal_ids"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "edits_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true,
          "description": "Existing tests, by pytest node ID, whose definitions the change modifies. Omit it when the change edits no existing test."
        },
        "no_design_questions": {
          "type": "boolean"
        },
        "lands_on_its_own": {
          "type": "boolean"
        },
        "forecast": {
          "$ref": "#/$defs/forecast"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Code-owned rule violations. The model must omit this field."
        },
        "memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "IDs of supplied memories this reply relied on."
        },
        "memory_flags": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "claim": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1000,
                "description": "The memory's own words that the evidence contradicts, quoted verbatim from its content."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "path",
                  "start_line",
                  "end_line",
                  "quote"
                ],
                "additionalProperties": false,
                "description": "A verbatim quote of at most 40 lines from the read-only checkout, at these 1-based lines of this repo-relative file."
              }
            },
            "required": [
              "id",
              "claim",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "description": "Cited memories the checkout shows to be wrong, each with the evidence that contradicts it. Code checks the quote before the memory is retired."
        },
        "conventions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "path",
                  "start_line",
                  "end_line",
                  "quote"
                ],
                "additionalProperties": false,
                "description": "A verbatim quote of at most 40 lines from the read-only checkout, at these 1-based lines of this repo-relative file."
              }
            },
            "required": [
              "text",
              "evidence"
            ],
            "additionalProperties": false
          },
          "description": "Repository conventions the checkout shows, each with evidence, kept for later requests. Code checks the quote."
        },
        "decision_context": {
          "$ref": "decision-context.json",
          "description": "Code supplies the applicable approvals and restrictions from the planner inputs."
        },
        "evidence_contract": {
          "$ref": "ingest-reply.json#/$defs/evidence_contract"
        },
        "evidence_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "uniqueItems": true,
          "maxItems": 1024,
          "description": "Code-owned unsupported evidence requirements."
        },
        "forcing_rehearsals": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object"
          },
          "description": "Code-owned verified planner rehearsal receipts. Independent Checking is still required."
        }
      },
      "required": [
        "kind",
        "files",
        "checks",
        "no_design_questions",
        "lands_on_its_own"
      ],
      "additionalProperties": false
    },
