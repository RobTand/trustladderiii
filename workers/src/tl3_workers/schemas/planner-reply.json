{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "declared_symptom": {
          "$ref": "#/$defs/DeclaredSymptom"
        },
        "forcing": {
          "$ref": "#/$defs/Forcing"
        },
        "goal_ids": {
          "description": "Original ingest.goals indices. Required, unique, never renumbered across splits.\nThe planner gate checks nonempty/range/coverage; controller controls explicitly use [].",
          "items": {
            "$ref": "#/$defs/GoalId"
          },
          "type": "array",
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "demonstrating",
            "regression",
            "behavior-preserving"
          ]
        },
        "name": {
          "type": "string"
        },
        "proof": {
          "$ref": "#/$defs/ProofDeclaration"
        },
        "tests": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "goal_ids",
        "kind",
        "tests"
      ],
      "type": "object"
    },
    "CheckKind": {
      "enum": [
        "demonstrating",
        "regression",
        "behavior-preserving",
        "reproducing"
      ],
      "type": "string"
    },
    "DeclaredSymptom": {
      "additionalProperties": false,
      "properties": {
        "exception": {
          "pattern": "^[A-Za-z_]\\w*(\\.[A-Za-z_]\\w*)+$",
          "type": "string"
        },
        "node": {
          "minLength": 1,
          "type": "string"
        },
        "parallel": {
          "enum": [
            0,
            2,
            3,
            4
          ]
        },
        "phase": {
          "$ref": "#/$defs/SymptomPhase"
        },
        "repeat": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "node",
        "exception",
        "phase",
        "repeat",
        "parallel"
      ],
      "type": "object"
    },
    "Forcing": {
      "additionalProperties": false,
      "description": "A forced reproduction (#393): the declarative condition the harness applies, outside the test, to recreate a flake. Only on demonstrating checks.",
      "properties": {
        "environment": {
          "additionalProperties": {
            "maxLength": 1000,
            "type": "string"
          },
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "type": "object"
        },
        "patches": {
          "items": {
            "additionalProperties": false,
            "maxProperties": 2,
            "minProperties": 2,
            "properties": {
              "delay_seconds": {
                "exclusiveMinimum": 0,
                "maximum": 5,
                "type": "number"
              },
              "raises": {
                "minLength": 1,
                "type": "string"
              },
              "returns": {},
              "target": {
                "maxLength": 200,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$",
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "target"
            ],
            "type": "object"
          },
          "maxItems": 8,
          "type": "array"
        },
        "symptom": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "symptom",
        "environment",
        "patches"
      ],
      "type": "object"
    },
    "GoalId": {
      "description": "Original zero-based index in request.inputs.ingest.goals, retained across splits.",
      "minimum": 0,
      "type": "integer"
    },
    "ProofDeclaration": {
      "additionalProperties": false,
      "properties": {
        "observer_support": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|::|$))[^\\\\\\u0000\\r\\n]+\\.py(?:::[A-Za-z_][A-Za-z_0-9]*)*$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "red_message": {
          "description": "Planner-declared EXPECTED assertion message, never captured run evidence.\nRust checks actual-run RED messages independently before accepting the proof.",
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        "subjects": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|::|$))[^\\\\\\u0000\\r\\n]+\\.py(?:::[A-Za-z_][A-Za-z_0-9]*)*$",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "subjects",
        "observer_support",
        "red_message"
      ],
      "type": "object"
    },
    "SymptomPhase": {
      "enum": [
        "call",
        "setup"
      ],
      "type": "string"
    },
    "execution": {
      "additionalProperties": false,
      "description": "Code-owned execution estimate. Does not replace the exact token forecast or grant fresh maker allowance.",
      "properties": {
        "aggregate_allowed_tool_turns": {
          "minimum": 0,
          "type": "integer"
        },
        "aggregate_tool_turns": {
          "minimum": 0,
          "type": "integer"
        },
        "allowed_tool_turns": {
          "minimum": 0,
          "type": "integer"
        },
        "components": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "estimated_tool_turns": {
          "minimum": 0,
          "type": "integer"
        },
        "exploration_declared": {
          "type": "boolean"
        },
        "finalization_turns": {
          "minimum": 0,
          "type": "integer"
        },
        "fits": {
          "type": "boolean"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/execution"
          },
          "type": "array"
        },
        "usable_tool_turns": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "allowed_tool_turns",
        "finalization_turns",
        "usable_tool_turns",
        "estimated_tool_turns",
        "components",
        "exploration_declared",
        "fits"
      ],
      "type": "object"
    },
    "forecast": {
      "additionalProperties": false,
      "description": "Appended by the reply check. The model must omit this field.",
      "properties": {
        "brief_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "context_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "file_tokens": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "fit_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "fits": {
          "type": "boolean"
        },
        "overhead_tokens": {
          "minimum": 0,
          "type": "integer"
        },
        "tokenizer": {
          "const": "o200k_base"
        },
        "tokens": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tokenizer",
        "brief_tokens",
        "file_tokens",
        "overhead_tokens",
        "tokens",
        "fit_tokens",
        "context_tokens",
        "fits"
      ],
      "type": "object"
    }
  },
