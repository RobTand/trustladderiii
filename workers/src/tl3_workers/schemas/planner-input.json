{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/planner-input.json",
  "type": "object",
  "properties": {
    "must_split": {
      "type": "boolean",
      "description": "True after a maker ran out of room. A leaf reply is rejected."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Everything learned before a re-plan, including failed checks and review findings. Empty for initial planning."
    },
    "protected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Controller-supplied repo-relative glob patterns. A leaf or split cannot declare matching files. ** matches zero or more path segments."
    },
    "ingest": {
      "allOf": [
        {
          "$ref": "ingest-reply.json"
        },
        {
          "properties": {
            "kind": {
              "const": "brief"
            }
          }
        }
      ]
    },
    "forecast": {
      "type": "object",
      "properties": {
        "fit_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "overhead_tokens": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Named overhead constants from controller config, summed by code."
        }
      },
      "required": [
        "fit_tokens",
        "context_tokens",
        "overhead_tokens"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "must_split",
    "findings",
    "protected_paths",
    "ingest",
    "forecast"
  ],
  "additionalProperties": false
}
