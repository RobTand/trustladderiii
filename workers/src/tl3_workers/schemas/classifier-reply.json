{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/classifier-reply.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "change_request"
        },
        "new_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "new_text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "stop",
            "pause",
            "resume",
            "remark"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "unsure"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S",
          "not": {
            "pattern": "[\\r\\n\\u0085\\u2028\\u2029]"
          }
        }
      },
      "required": [
        "kind",
        "question"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "complaint"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "not": {
            "pattern": "[\\r\\n\\u0085\\u2028\\u2029]"
          }
        },
        "revert": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "summary",
        "revert"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "answer"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "enum": [
            "continue",
            "stop",
            "retry",
            "mark_handled",
            "unclear"
          ]
        }
      },
      "required": [
        "kind",
        "question_id",
        "answer"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "answer"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "const": "change_request"
        },
        "new_text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "question_id",
        "answer",
        "new_text"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "answer"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "const": "try_again"
        },
        "guidance": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "question_id",
        "answer",
        "guidance"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "answer"
        },
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "const": "add_credit"
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "kind",
        "question_id",
        "answer",
        "amount"
      ],
      "additionalProperties": false
    }
  ]
}
