{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/ingest-input.json",
  "type": "object",
  "properties": {
    "issue": {
      "$ref": "#/$defs/issue"
    },
    "repo": {
      "$ref": "#/$defs/repo"
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "audit_objections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "issue",
    "repo"
  ],
  "additionalProperties": false,
  "$defs": {
    "issue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "author": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "author",
              "body"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "number",
        "title",
        "body",
        "author",
        "comments"
      ],
      "additionalProperties": false
    },
    "repo": {
      "type": "object",
      "properties": {
        "readme": {
          "type": "string"
        },
        "file_list": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "readme",
        "file_list"
      ],
      "additionalProperties": false
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "content"
        ],
        "additionalProperties": false
      }
    }
  }
}
