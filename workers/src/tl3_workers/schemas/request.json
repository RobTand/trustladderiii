{
  "$defs": {
    "WorkerRequestMemory": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "minimum": 0,
          "type": "integer"
        },
        "issue": {
          "minimum": 1,
          "type": "integer"
        },
        "repo": {
          "type": "string"
        },
        "request": {
          "type": "string"
        },
        "summary_file": {
          "pattern": "^/",
          "type": "string"
        }
      },
      "required": [
        "summary_file",
        "repo",
        "issue",
        "request",
        "epoch"
      ],
      "type": "object"
    },
    "WorkerRequestModel": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "pattern": "^https?://[^/\\s]+(?:/[^\\s]*)?$",
          "type": "string"
        },
        "budget_tokens": {
          "minimum": 1,
          "type": "integer"
        },
        "effort": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "base_url",
        "name",
        "effort",
        "budget_tokens"
      ],
      "type": "object"
    },
    "WorkerRequestOperation": {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "minLength": 1,
          "type": "string"
        },
        "node": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "node",
        "generation",
        "kind"
      ],
      "type": "object"
    },
    "WorkerRequestPrompt": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "text"
      ],
      "type": "object"
    }
  },
  "$id": "https://trustladderiii.invalid/workers/protocol-1/request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "hindsight_key_file": {
      "pattern": "^/",
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "additionalProperties": true,
      "type": "object"
    },
    "key_file": {
      "pattern": "^/",
      "type": "string"
    },
    "last_accepted_generation": {
      "minimum": 0,
      "type": "integer"
    },
    "memory": {
      "$ref": "#/$defs/WorkerRequestMemory"
    },
    "mlflow": {
      "additionalProperties": true,
      "type": [
        "object",
        "null"
      ]
    },
    "model": {
      "$ref": "#/$defs/WorkerRequestModel"
    },
    "no_progress_secs": {
      "description": "The agent worker no-progress allowance in seconds; the maker retro stays inside half of it.",
      "minimum": 1,
      "type": "integer"
    },
    "operation": {
      "$ref": "#/$defs/WorkerRequestOperation"
    },
    "prompt": {
      "$ref": "#/$defs/WorkerRequestPrompt"
    },
    "protocol": {
      "const": 1,
      "minimum": 0,
      "type": "integer"
    },
    "resume_session": {
      "type": "boolean"
    },
    "role": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "session_file": {
      "pattern": "^/",
      "type": "string"
    },
    "silence_secs": {
      "description": "The agent worker silence allowance in seconds; the maker retro stays inside half of it.",
      "minimum": 1,
      "type": "integer"
    },
    "test_cpus": {
      "minimum": 1,
      "type": "integer"
    },
    "trace": {
      "additionalProperties": true,
      "type": "object"
    },
    "worktree": {
      "pattern": "^/",
      "type": "string"
    }
  },
  "required": [
    "protocol",
    "operation",
    "role",
    "model",
    "key_file",
    "inputs",
    "worktree"
  ],
  "type": "object"
}
