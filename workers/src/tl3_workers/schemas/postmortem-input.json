{
  "$defs": {
    "Case": {
      "additionalProperties": false,
      "properties": {
        "audit": true,
        "brief": true,
        "findings": true,
        "grades": {
          "items": true,
          "type": "array"
        },
        "incidents": {
          "items": true,
          "type": "array"
        },
        "outcome": {
          "minLength": 1,
          "type": "string"
        },
        "phases": {
          "items": true,
          "type": "array"
        },
        "plan": true,
        "questions": {
          "items": true,
          "type": "array"
        },
        "release": {
          "type": "string"
        },
        "request": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "request",
        "outcome",
        "grades",
        "phases",
        "questions",
        "incidents",
        "release"
      ],
      "type": "object"
    },
    "PostmortemInputRubric": {
      "additionalProperties": true,
      "properties": {
        "dimensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "dimensions"
      ],
      "type": "object"
    },
    "PostmortemRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minimum": 1,
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "trigger": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "trigger",
        "reason"
      ],
      "type": "object"
    },
    "PostmortemTags": {
      "additionalProperties": false,
      "properties": {
        "issue": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "node": {
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "repo": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "request": {
          "pattern": "^[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "node",
        "request",
        "repo",
        "issue"
      ],
      "type": "object"
    }
  },
  "$id": "https://trustladderiii.invalid/workers/protocol-1/postmortem-input.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The case file the controller writes for one postmortem (#403). The worker redacts `case` before any judge reads it.",
  "properties": {
    "case": {
      "$ref": "#/$defs/Case"
    },
    "deadline_secs": {
      "description": "The run's whole wall-clock allowance (#486).",
      "minimum": 1,
      "type": "integer"
    },
    "grade_model": {
      "minLength": 1,
      "type": "string"
    },
    "record": {
      "$ref": "#/$defs/PostmortemRecord"
    },
    "release": {
      "type": "string"
    },
    "rubric": {
      "$ref": "#/$defs/PostmortemInputRubric"
    },
    "trace_tags": {
      "$ref": "#/$defs/PostmortemTags"
    }
  },
  "required": [
    "record",
    "case",
    "rubric",
    "release",
    "grade_model",
    "deadline_secs",
    "trace_tags"
  ],
  "type": "object"
}
