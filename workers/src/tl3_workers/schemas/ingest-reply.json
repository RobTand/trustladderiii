{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/ingest-reply.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "brief"
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80000
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "test",
                  "review"
                ]
              },
              "stage": {
                "enum": [
                  "maker",
                  "checking",
                  "publishing"
                ]
              },
              "publication": {
                "type": "object",
                "properties": {
                  "branch": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "branch_prefix": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "non_draft": {
                    "const": true
                  },
                  "body_lines": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "pattern": "^[^\\r\\n]+$"
                    }
                  },
                  "proof": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "non_draft",
                  "body_lines",
                  "proof"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "description",
              "verification"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "required": [
                    "stage"
                  ],
                  "properties": {
                    "stage": {
                      "const": "publishing"
                    }
                  }
                },
                "then": {
                  "required": [
                    "publication"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "publication"
                    ]
                  }
                }
              }
            ]
          },
          "minItems": 1
        },
        "memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forecast": {
          "$ref": "#/$defs/forecast"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Files in the root scope used by the forecaster. Required when forecast settings are supplied."
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Concrete repository-relative paths that MUST change to meet the request's goals. Report only when the whole request cannot land usefully without these edits; never for inspected files, excluded edits, or an optional part. The controller verifies the effective protected-path list."
        },
        "memory_flags": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "claim": {
                "type": "string",
                "minLength": 8,
                "maxLength": 1000,
                "description": "The memory's own words that the evidence contradicts, quoted verbatim from its content."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "start_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "end_line": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "path",
                  "start_line",
                  "end_line",
                  "quote"
                ],
                "additionalProperties": false,
                "description": "A verbatim quote of at most 40 lines from the read-only checkout, at these 1-based lines of this repo-relative file."
              }
            },
            "required": [
              "id",
              "claim",
              "reason",
              "evidence"
            ],
            "additionalProperties": false
          },
          "description": "Cited memories the checkout shows to be wrong, each with the evidence that contradicts it. Code checks the quote before the memory is retired."
        },
        "evidence_contract": {
          "$ref": "#/$defs/evidence_contract"
        },
        "evidence_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "uniqueItems": true,
          "maxItems": 1024,
          "description": "Code-owned unsupported evidence requirements."
        }
      },
      "required": [
        "kind",
        "brief",
        "goals",
        "memory_ids"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "early_end"
        },
        "outcome": {
          "enum": [
            "duplicate",
            "already_done",
            "not_actionable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Concrete repository-relative paths that MUST change to meet the request's goals. Report only when the whole request cannot land usefully without these edits; never for inspected files, excluded edits, or an optional part. The controller verifies the effective protected-path list."
        },
        "evidence_contract": {
          "$ref": "#/$defs/evidence_contract"
        },
        "evidence_errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "uniqueItems": true,
          "maxItems": 1024,
          "description": "Code-owned unsupported evidence requirements."
        }
      },
      "required": [
        "kind",
        "outcome",
        "reason"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "forecast": {
      "type": "object",
      "properties": {
        "tokenizer": {
          "const": "o200k_base"
        },
        "brief_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "file_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "overhead_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "fit_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "fits": {
          "type": "boolean"
        }
      },
      "required": [
        "tokenizer",
        "brief_tokens",
        "file_tokens",
        "overhead_tokens",
        "tokens",
        "fit_tokens",
        "context_tokens",
        "fits"
      ],
      "additionalProperties": false,
      "description": "Appended by the reply check. The model must omit this field."
    },
    "tool_capability": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runner_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "protected_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        }
      },
      "required": [
        "tool",
        "executor",
        "runner_features",
        "artifacts",
        "methods",
        "protected_files"
      ],
      "additionalProperties": false
    },
    "evidence_requirement": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runner_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "protected_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "provenance": {
          "description": "Source obligations are immutable across roles; method choices may be replaced. Omitted provenance is a legacy mandatory requirement.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "source"
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "kind",
                "source",
                "quote"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "method"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "tool",
        "executor",
        "runner_features",
        "artifacts",
        "methods",
        "protected_files",
        "requirement"
      ],
      "additionalProperties": false
    },
    "evidence_contract": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_requirement"
      },
      "maxItems": 64
    }
  }
}
