{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/ingest-reply.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "brief"
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80000
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "test",
                  "review"
                ]
              }
            },
            "required": [
              "description",
              "verification"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "brief",
        "goals",
        "memory_ids"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "early_end"
        },
        "outcome": {
          "enum": [
            "duplicate",
            "already_done",
            "not_actionable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "outcome",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
