{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustladderiii.invalid/workers/protocol-1/ingest-reply.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "brief"
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80000
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "enum": [
                  "test",
                  "review"
                ]
              }
            },
            "required": [
              "description",
              "verification"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "memory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "forecast": {
          "$ref": "#/$defs/forecast"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Files in the root scope used by the forecaster. Required when forecast settings are supplied."
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Concrete repository-relative paths that MUST change to meet the request's goals. Report only when the whole request cannot land usefully without these edits; never for inspected files, excluded edits, or an optional part. The controller verifies the effective protected-path list."
        }
      },
      "required": [
        "kind",
        "brief",
        "goals",
        "memory_ids"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "early_end"
        },
        "outcome": {
          "enum": [
            "duplicate",
            "already_done",
            "not_actionable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Concrete repository-relative paths that MUST change to meet the request's goals. Report only when the whole request cannot land usefully without these edits; never for inspected files, excluded edits, or an optional part. The controller verifies the effective protected-path list."
        }
      },
      "required": [
        "kind",
        "outcome",
        "reason"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "forecast": {
      "type": "object",
      "properties": {
        "tokenizer": {
          "const": "o200k_base"
        },
        "brief_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "file_tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "overhead_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "fit_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "context_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "fits": {
          "type": "boolean"
        }
      },
      "required": [
        "tokenizer",
        "brief_tokens",
        "file_tokens",
        "overhead_tokens",
        "tokens",
        "fit_tokens",
        "context_tokens",
        "fits"
      ],
      "additionalProperties": false,
      "description": "Appended by the reply check. The model must omit this field."
    }
  }
}
