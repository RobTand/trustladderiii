load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:python.bzl", "tl3_py_test")

py_binary(
    name = "inventory",
    srcs = ["inventory.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

py_binary(
    name = "prepare_image",
    srcs = ["prepare_image.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "verify",
    srcs = ["verify.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":verify_reproducing",
        ":verify_scratch",
        "//harness/src/tl3_harness",
    ],
)

py_binary(
    name = "verify_reproducing",
    srcs = ["verify_reproducing.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

py_binary(
    name = "verify_scratch",
    srcs = ["verify_scratch.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":verify_reproducing",
        "//harness/src/tl3_harness",
    ],
)

filegroup(
    name = "sources",
    srcs = glob([
        "*.py",
        "images/**",
    ]),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "verify_generator",
    srcs = ["verify_generator.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

py_binary(
    name = "verify_disk_scratch",
    srcs = ["verify_disk_scratch.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

tl3_py_test(
    name = "test_verify_disk_scratch",
    srcs = ["test_verify_disk_scratch.py"],
    data = [":verify_disk_scratch"],
    deps = ["//harness/src/tl3_harness"],  # keep
)
