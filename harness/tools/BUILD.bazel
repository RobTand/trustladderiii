# gazelle:resolve py python.runfiles @rules_python//python/runfiles
# gazelle:resolve py python.runfiles.runfiles @rules_python//python/runfiles

load("@rules_python//python:defs.bzl", "py_binary")
load("//tools/bazel:python.bzl", "tl3_py_test")

py_binary(
    name = "inventory",
    srcs = ["inventory.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

py_binary(
    name = "prepare_image",
    srcs = ["prepare_image.py"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "verify",
    srcs = ["verify.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":verify_reproducing",
        ":verify_scratch",
        "//harness/src/tl3_harness",
    ],
)

py_binary(
    name = "verify_reproducing",
    srcs = ["verify_reproducing.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

py_binary(
    name = "verify_scratch",
    srcs = ["verify_scratch.py"],
    visibility = ["//visibility:public"],
    deps = [
        ":verify_reproducing",
        "//harness/src/tl3_harness",
    ],
)

filegroup(
    name = "sources",
    srcs = glob([
        "*.py",
        "images/**",
    ]),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "verify_generator",
    srcs = ["verify_generator.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

py_binary(
    name = "job_worker_probe",
    srcs = ["job_worker_probe.py"],
    visibility = ["//visibility:public"],
    deps = [
        "//workers/src",
        "@tl3_pip//jsonschema",
        "@tl3_pip//mlflow_skinny",
    ],
)

py_binary(
    name = "staged_job_probe",
    srcs = ["staged_job_probe.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)

py_binary(
    name = "prepare_runtime",
    srcs = ["prepare_runtime.py"],
    visibility = ["//visibility:public"],
    deps = ["//harness/src/tl3_harness"],
)
